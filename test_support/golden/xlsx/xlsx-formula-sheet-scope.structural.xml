<workbook density="structural" format="xlsx">
  <sheet name="First">
    <grid ref="A1:B3">
      <tr number="1">
        <cell formula="B1*2">2</cell>
        <cell>1</cell>
      </tr>
      <tr number="2">
        <cell formula="B2*2">4</cell>
        <cell>2</cell>
      </tr>
      <tr number="3">
        <cell formula="B3*2">6</cell>
        <cell>3</cell>
      </tr>
    </grid>
  </sheet>
  <sheet name="Second">
    <grid ref="A1:B3">
      <tr number="1">
        <cell formula="B1+3">4</cell>
        <cell>1</cell>
      </tr>
      <tr number="2">
        <cell formula="B2+3">5</cell>
        <cell>2</cell>
      </tr>
      <tr number="3">
        <cell formula="B3+3">6</cell>
        <cell>3</cell>
      </tr>
    </grid>
  </sheet>
</workbook>
